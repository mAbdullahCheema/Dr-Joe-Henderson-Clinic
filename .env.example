# Copy to .env.local and fill in. .env.local is gitignored.

# n8n webhook that receives appointment bookings and newsletter signups.
# Create a Webhook node in n8n, set it to POST, and paste its production URL here.
# Because this is a VITE_ var it is bundled into the client build and therefore
# public once deployed — protect the endpoint in n8n (rate limit + validate the
# payload), do not rely on the URL being secret.
VITE_N8N_BOOKING_WEBHOOK=https://your-instance.app.n8n.cloud/webhook/your-webhook-id
